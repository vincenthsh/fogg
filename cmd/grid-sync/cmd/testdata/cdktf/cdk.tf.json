{
  "data": {
    "terraform_remote_state": {
      "images": {
        "backend": "http",
        "config": {
          "address": "https://grid.example.com/tfstate/33333333-3333-3333-3333-333333333333"
        }
      },
      "vpc": {
        "backend": "http",
        "config": {
          "address": "https://grid.example.com/tfstate/44444444-4444-4444-4444-444444444444"
        }
      }
    }
  },
  "resource": {
    "aws_instance": {
      "web": {
        "ami": "${data.terraform_remote_state.images.outputs.ami_id}",
        "tags": {
          "Name": "web-${data.terraform_remote_state.vpc.outputs.vpc_name}"
        }
      }
    }
  }
}